#!/bin/sh

# These defaults are packaged into every image, so they can run after sysupgrade too.
[ -f /etc/backup/installed_packages.txt ] && exit 0

changed=0

lang="$(uci -q get luci.main.lang)"
case "${lang}" in
    ""|auto)
        uci -q set luci.main.lang='zh_cn' && changed=1
        ;;
esac

mediaurlbase="$(uci -q get luci.main.mediaurlbase)"
case "${mediaurlbase}" in
    ""|/luci-static/bootstrap)
        uci -q set luci.main.mediaurlbase='/luci-static/aurora' && changed=1
        ;;
esac

[ "${changed}" = "1" ] && uci -q commit luci

exit 0
